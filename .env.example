# Phase 0 requires no external provider credentials.
HOMEBASE_PORT=3000
HOMEBASE_API_PORT=4000
HOMEBASE_API_PUBLIC_URL=http://localhost:4000
HOMEBASE_WEB_ORIGIN=http://localhost:3000
HOMEBASE_ENV=development
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://homebase:change_me@db:5432/homebase

# Phase 1 Proxmox (leave blank to keep the integration disabled)
PROXMOX_BASE_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_TLS_VERIFY=true
PROXMOX_STORAGE_WARNING_PERCENT=80
PROXMOX_CPU_WARNING_PERCENT=90
PROXMOX_MEMORY_WARNING_PERCENT=90
PROXMOX_EXPECTED_DOWN_IDS=

# Phase 2: server-only, restricted read-only Docker proxy and Kuma metrics
DOCKER_PROXY_URL=
DOCKER_EXPECTED_DOWN_NAMES=
DOCKER_RESTART_WARNING_COUNT=5
UPTIME_KUMA_BASE_URL=
UPTIME_KUMA_API_KEY=
SERVICE_REFRESH_SECONDS=60

# Phase 3: core home systems (server-side only)
PIHOLE_BASE_URL=
PIHOLE_APP_PASSWORD=
PLEX_BASE_URL=
PLEX_TOKEN=
# Active sessions refresh independently of slower home systems (5–300 seconds).
PLEX_REFRESH_SECONDS=15
HOME_ASSISTANT_BASE_URL=
HOME_ASSISTANT_TOKEN=
HOMEBASE_TIMEZONE=America/New_York
FAMILY_CALENDAR_DAYS=7
FAMILY_REFRESH_SECONDS=120
GAMES_LEAGUE_URL=https://www.leagueoflegends.com/en-us/news/tags/patch-notes/
GAMES_LEAGUE_COMMUNITY_URL=https://www.reddit.com/r/summonerschool/
GAMES_DEADLOCK_URL=https://forums.playdeadlock.com/forums/changelog.10/
GAMES_REFRESH_SECONDS=21600
TAILSCALE_STATUS_URL=
HOME_SYSTEM_REFRESH_SECONDS=120

# Phase 4: authoritative security intelligence (no credentials required)
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
NVD_CVE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=
SECURITY_LOOKBACK_DAYS=30
SECURITY_MAX_ADVISORIES=100
SECURITY_REFRESH_SECONDS=21600

# Phase 5: Career Radar (public Greenhouse, Lever, and Ashby GET endpoints; no credentials required)
CAREER_GREENHOUSE_BOARDS=gitlab:GitLab,cloudflare:Cloudflare,canonical:Canonical,datadog:Datadog,elastic:Elastic
CAREER_LEVER_BOARDS=spotify:Spotify,wealthsimple:Wealthsimple,palantir:Palantir
CAREER_ASHBY_BOARDS=vanta:Vanta,ramp:Ramp,notion:Notion
CAREER_MOCK_ENABLED=false
CAREER_MAX_JOBS=150
CAREER_REFRESH_SECONDS=21600

# Compose runs a dedicated worker; for local development, export COLLECTION_MODE=worker
# in the API shell and run pnpm worker in a separate shell with the same database/env.
COLLECTOR_RUN_RETENTION_DAYS=30

# Optional OpenWeb Ninja JSearch free plan: up to 5 requests per 24 hours.
CAREER_JSEARCH_API_KEY=
